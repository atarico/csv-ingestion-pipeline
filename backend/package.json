{
  "name": "csv-pipeline-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run copy:prisma-runtime",
    "copy:prisma-runtime": "mkdir -p dist/generated/prisma && cp -R src/generated/prisma/. dist/generated/prisma/",
    "start": "node dist/main/index.js",
    "worker": "tsx src/workers/index.ts",
    "worker:start": "node dist/workers/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:new": "prisma migrate dev --name",
    "prisma:studio": "prisma studio",
    "test:coverage": "vitest run --coverage --project unit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/client-sqs": "3.1149.0",
    "@fastify/cors": "11.3.1",
    "@fastify/multipart": "10.1.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "awilix": "13.0.5",
    "convict": "6.2.5",
    "csv-parse": "7.0.3",
    "dotenv": "^17.4.2",
    "fastify": "5.12.5",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/convict": "6.1.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
